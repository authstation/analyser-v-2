# ── App ────────────────────────────────────────────
APP_ENV=production
APP_NAME=Analyser
APP_PORT=3010
APP_URL=http://localhost:3010

# ── Admin Bootstrap (Auto-created on deploy/startup) ──
ADMIN_NAME="System Admin"
ADMIN_EMAIL=admin@analyser.local
ADMIN_PASSWORD=ChangeThisPassword123

# Frontend origin when UI is on a different domain than the API.
# Leave empty if UI is served from the same APP_URL.
FRONTEND_URL=
VITE_API_BASE_URL=/api
VITE_API_URL=/api

# ── Database ───────────────────────────────────────
# Supported: postgres://, mysql://, sqlite: prefix
DATABASE_URL=postgres://postgres:password@localhost:5432/analyser_db

# ── Secrets ────────────────────────────────────────
JWT_ACCESS_SECRET=your-jwt-access-secret-key-change-this
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-change-this
COOKIE_SECRET=your-cookie-secret-key-change-this
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Redis (Optional) ────────────────────────────────
# Set true to enable Redis cache, session, queue, events
REDIS=false
REDIS_URL=redis://127.0.0.1:6379
REDIS_PREFIX=analyser

# ── Feature Toggle ─────────────────────────────────
# Set false for API-only mode (no UI build/serve)
UI=true
# Set true to enable OpenAPI / Scalar docs at /api-docs
OPEN_API=true
# Set true to enable Socket.IO realtime server
SOCKET=true
